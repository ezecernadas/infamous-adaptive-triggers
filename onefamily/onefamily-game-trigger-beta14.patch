diff --git a/daemon/src/dualsense_trigger.c b/daemon/src/dualsense_trigger.c
new file mode 100644
index 0000000..567e594
--- /dev/null
+++ b/daemon/src/dualsense_trigger.c
@@ -0,0 +1,33 @@
+#include "dualsense_trigger.h"
+
+#include <string.h>
+
+void dualsense_trigger_effect(int preset, uint8_t out[DS_TRIGGER_EFFECT_SIZE]) {
+    memset(out, 0, DS_TRIGGER_EFFECT_SIZE);
+
+    switch (preset) {
+    case DS_TRIGGER_PRESET_HAIR:
+        // Firm click right after the trigger starts moving (~12% to ~30% of travel)
+        out[0] = DS_TRIGGER_MODE_WEAPON;
+        out[1] = 0x20;  // start position
+        out[2] = 0x50;  // end position (resistance releases here)
+        out[3] = 0xFF;  // strength
+        break;
+    case DS_TRIGGER_PRESET_RESISTANCE:
+        // Medium resistance over the whole travel
+        out[0] = DS_TRIGGER_MODE_FEEDBACK;
+        out[1] = 0x00;  // start position
+        out[2] = 0x64;  // strength
+        break;
+    case DS_TRIGGER_PRESET_VIBRATION:
+        out[0] = DS_TRIGGER_MODE_VIBRATION;
+        out[1] = 0x0C;  // frequency (Hz)
+        out[2] = 0xC8;  // amplitude
+        out[3] = 0x00;  // start position
+        break;
+    default:
+        // Mode 0x05 actively releases the motor; 0x00 would leave the last effect applied
+        out[0] = DS_TRIGGER_MODE_OFF;
+        break;
+    }
+}
diff --git a/daemon/src/game_trigger.c b/daemon/src/game_trigger.c
new file mode 100644
index 0000000..70046f5
--- /dev/null
+++ b/daemon/src/game_trigger.c
@@ -0,0 +1,49 @@
+#include "game_trigger.h"
+
+#include <string.h>
+
+#include "bt_driver.h"
+#include "daemon_syscalls.h"
+#include "game_trigger_protocol.h"
+#include "log.h"
+
+static GameTriggerOverride s_override;
+static int s_initialized;
+
+void game_trigger_poll(uint64_t now_us) {
+    if (!s_initialized) {
+        game_trigger_override_init(&s_override);
+        s_initialized = 1;
+    }
+
+    int changed = 0;
+    int fd = daemon_sys_open(GAME_TRIGGER_PATH, 0 /* O_RDONLY */, 0);
+    if (fd >= 0) {
+        uint8_t buf[GAME_TRIGGER_MESSAGE_SIZE];
+        int n = daemon_sys_read(fd, buf, sizeof(buf));
+        daemon_sys_close(fd);
+        GameTriggerMessage m;
+        if (game_trigger_decode(buf, n, &m)) {
+            int was_active = game_trigger_override_active(&s_override);
+            changed = game_trigger_override_update(&s_override, &m, now_us);
+            if (changed && was_active != game_trigger_override_active(&s_override)) {
+                daemon_log(LOG_LEVEL_INFO, "Game trigger override %s (seq=%u)",
+                           game_trigger_override_active(&s_override) ? "on" : "off", m.seq);
+            }
+        }
+    }
+
+    if (game_trigger_override_expire(&s_override, now_us)) {
+        daemon_log(LOG_LEVEL_INFO, "Game trigger override expired: back to the user's trigger setting");
+        changed = 1;
+    }
+
+    if (changed) bt_driver_resend_output();
+}
+
+int game_trigger_effects(uint8_t r2[11], uint8_t l2[11]) {
+    if (!s_initialized || !game_trigger_override_active(&s_override)) return 0;
+    memcpy(r2, s_override.r2, GAME_TRIGGER_EFFECT_SIZE);
+    memcpy(l2, s_override.l2, GAME_TRIGGER_EFFECT_SIZE);
+    return 1;
+}
