diff --git a/daemon/tests/test_dualsense_trigger.c b/daemon/tests/test_dualsense_trigger.c
new file mode 100644
index 0000000..5c72a30
--- /dev/null
+++ b/daemon/tests/test_dualsense_trigger.c
@@ -0,0 +1,67 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "dualsense_trigger.h"
+
+static void fill(int preset, uint8_t* e) {
+    memset(e, 0xAA, DS_TRIGGER_EFFECT_SIZE);
+    dualsense_trigger_effect(preset, e);
+}
+
+static void assert_tail_zero(const uint8_t* e, int from) {
+    for (int i = from; i < DS_TRIGGER_EFFECT_SIZE; i++) assert(e[i] == 0);
+}
+
+static void test_off_resets_the_motor(void) {
+    uint8_t e[DS_TRIGGER_EFFECT_SIZE];
+    fill(DS_TRIGGER_PRESET_OFF, e);
+    assert(e[0] == DS_TRIGGER_MODE_OFF);
+    assert_tail_zero(e, 1);
+}
+
+static void test_unknown_preset_is_off(void) {
+    uint8_t e[DS_TRIGGER_EFFECT_SIZE];
+    fill(42, e);
+    assert(e[0] == DS_TRIGGER_MODE_OFF);
+    fill(-1, e);
+    assert(e[0] == DS_TRIGGER_MODE_OFF);
+}
+
+static void test_hair_trigger_is_an_early_firm_click(void) {
+    uint8_t e[DS_TRIGGER_EFFECT_SIZE];
+    fill(DS_TRIGGER_PRESET_HAIR, e);
+    assert(e[0] == DS_TRIGGER_MODE_WEAPON);
+    assert(e[1] < 0x40);          /* starts early in the travel */
+    assert(e[2] > e[1]);          /* click releases after the start */
+    assert(e[3] >= 0xC0);         /* strong enough to feel */
+    assert_tail_zero(e, 4);
+}
+
+static void test_resistance_is_perceptible(void) {
+    uint8_t e[DS_TRIGGER_EFFECT_SIZE];
+    fill(DS_TRIGGER_PRESET_RESISTANCE, e);
+    assert(e[0] == DS_TRIGGER_MODE_FEEDBACK);
+    assert(e[1] == 0x00);         /* from the top of the travel */
+    assert(e[2] >= 0x64);         /* at least medium on the 0-255 scale */
+    assert_tail_zero(e, 3);
+}
+
+static void test_vibration_has_real_amplitude_and_frequency(void) {
+    uint8_t e[DS_TRIGGER_EFFECT_SIZE];
+    fill(DS_TRIGGER_PRESET_VIBRATION, e);
+    assert(e[0] == DS_TRIGGER_MODE_VIBRATION);
+    assert(e[1] >= 5);            /* frequency in Hz */
+    assert(e[2] >= 0x64);         /* amplitude */
+    assert_tail_zero(e, 4);
+}
+
+int main(void) {
+    test_off_resets_the_motor();
+    test_unknown_preset_is_off();
+    test_hair_trigger_is_an_early_firm_click();
+    test_resistance_is_perceptible();
+    test_vibration_has_real_amplitude_and_frequency();
+    puts("test_dualsense_trigger: all passed");
+    return 0;
+}
diff --git a/daemon/tests/test_game_trigger.c b/daemon/tests/test_game_trigger.c
new file mode 100644
index 0000000..00b2400
--- /dev/null
+++ b/daemon/tests/test_game_trigger.c
@@ -0,0 +1,110 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "game_trigger_protocol.h"
+
+static void sample(GameTriggerMessage* m, uint32_t seq, uint8_t r2_mode) {
+    memset(m, 0, sizeof(*m));
+    game_trigger_message_init(m);
+    m->flags = GAME_TRIGGER_FLAG_ACTIVE;
+    m->seq = seq;
+    m->r2[0] = r2_mode;
+    m->l2[0] = 0x05;
+}
+
+static void test_message_round_trip(void) {
+    GameTriggerMessage m, out;
+    sample(&m, 7, 0x06);
+    uint8_t buf[GAME_TRIGGER_MESSAGE_SIZE];
+    game_trigger_encode(&m, buf);
+    assert(game_trigger_decode(buf, sizeof(buf), &out));
+    assert(out.seq == 7 && out.r2[0] == 0x06 && out.flags == GAME_TRIGGER_FLAG_ACTIVE);
+}
+
+static void test_rejects_bad_input(void) {
+    GameTriggerMessage m, out;
+    sample(&m, 1, 0x06);
+    uint8_t buf[GAME_TRIGGER_MESSAGE_SIZE];
+    game_trigger_encode(&m, buf);
+    assert(!game_trigger_decode(buf, sizeof(buf) - 1, &out));   /* short read */
+    buf[0] ^= 0xff;
+    assert(!game_trigger_decode(buf, sizeof(buf), &out));       /* wrong magic */
+    game_trigger_encode(&m, buf);
+    buf[4] = 99;
+    assert(!game_trigger_decode(buf, sizeof(buf), &out));       /* unknown version */
+    game_trigger_encode(&m, buf);
+    buf[12] = 0x77;                                             /* r2 mode not a known effect */
+    assert(!game_trigger_decode(buf, sizeof(buf), &out));
+}
+
+static void test_override_follows_messages(void) {
+    GameTriggerOverride o; game_trigger_override_init(&o);
+    GameTriggerMessage m;
+    sample(&m, 1, 0x06);
+    assert(game_trigger_override_update(&o, &m, 1000) == 1);   /* changed */
+    assert(game_trigger_override_active(&o));
+    assert(game_trigger_override_update(&o, &m, 2000) == 0);   /* same seq: nothing new */
+    m.flags = 0; m.seq = 2;
+    assert(game_trigger_override_update(&o, &m, 3000) == 1);
+    assert(!game_trigger_override_active(&o));                  /* game released the trigger */
+}
+
+static void test_override_expires_without_heartbeat(void) {
+    GameTriggerOverride o; game_trigger_override_init(&o);
+    GameTriggerMessage m;
+    sample(&m, 1, 0x06);
+    game_trigger_override_update(&o, &m, 0);
+    assert(game_trigger_override_expire(&o, GAME_TRIGGER_TIMEOUT_US - 1) == 0);
+    assert(game_trigger_override_active(&o));
+    assert(game_trigger_override_expire(&o, GAME_TRIGGER_TIMEOUT_US) == 1);   /* game gone */
+    assert(!game_trigger_override_active(&o));
+}
+
+static void test_heartbeat_keeps_it_alive(void) {
+    GameTriggerOverride o; game_trigger_override_init(&o);
+    GameTriggerMessage m;
+    sample(&m, 1, 0x06);
+    game_trigger_override_update(&o, &m, 0);
+    m.heartbeat = 1;                       /* same effect, newer heartbeat */
+    assert(game_trigger_override_update(&o, &m, GAME_TRIGGER_TIMEOUT_US - 10) == 0);
+    assert(game_trigger_override_expire(&o, GAME_TRIGGER_TIMEOUT_US + 10) == 0);
+    assert(game_trigger_override_active(&o));
+}
+
+static void test_stale_file_after_the_game_closed_is_not_reapplied(void) {
+    /* The game is closed: its last message stays on disk and is read again on every poll */
+    GameTriggerOverride o; game_trigger_override_init(&o);
+    GameTriggerMessage m;
+    sample(&m, 9, 0x21);
+    game_trigger_override_update(&o, &m, 0);
+    assert(game_trigger_override_expire(&o, GAME_TRIGGER_TIMEOUT_US) == 1);
+    for (uint64_t t = GAME_TRIGGER_TIMEOUT_US; t < 10 * GAME_TRIGGER_TIMEOUT_US; t += 20000) {
+        assert(game_trigger_override_update(&o, &m, t) == 0);   /* nothing new: no resend */
+        assert(game_trigger_override_expire(&o, t) == 0);        /* and no expire/reapply loop */
+        assert(!game_trigger_override_active(&o));
+    }
+}
+
+static void test_game_back_after_expiry_takes_over_again(void) {
+    GameTriggerOverride o; game_trigger_override_init(&o);
+    GameTriggerMessage m;
+    sample(&m, 9, 0x21);
+    game_trigger_override_update(&o, &m, 0);
+    game_trigger_override_expire(&o, GAME_TRIGGER_TIMEOUT_US);
+    m.heartbeat = 1;                       /* the game was only stalled: same seq, new heartbeat */
+    assert(game_trigger_override_update(&o, &m, GAME_TRIGGER_TIMEOUT_US + 5) == 1);
+    assert(game_trigger_override_active(&o) && o.r2[0] == 0x21);
+}
+
+int main(void) {
+    test_stale_file_after_the_game_closed_is_not_reapplied();
+    test_game_back_after_expiry_takes_over_again();
+    test_message_round_trip();
+    test_rejects_bad_input();
+    test_override_follows_messages();
+    test_override_expires_without_heartbeat();
+    test_heartbeat_keeps_it_alive();
+    puts("test_game_trigger: all passed");
+    return 0;
+}
